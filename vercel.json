{
  "rewrites": [
    {
      "source": "/api/cars/(.*)",
      "destination": "/api/toolApi"
    },
    {
      "source": "/api/aisensy/(.*)",
      "destination": "/api/toolApi"
    },
    {
      "source": "/api/referrals/(.*)",
      "destination": "/api/toolApi"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-quicks",
      "schedule": "30 1 * * *"
    }
  ]
}
